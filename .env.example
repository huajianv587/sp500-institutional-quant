# Institutional Quant platform. Copy this file to .env and fill only the keys you use.
# Production: use a Supabase Postgres direct or session-pooler connection string.
# Local DuckDB is retained only for tests and the explicitly synthetic demo.
IQ_DATABASE_BACKEND=supabase
SUPABASE_DB_URL=
IQ_DATABASE_PATH=data/institutional_quant.duckdb
IQ_PRICE_LAKE_PATH=data/market/prices.parquet
IQ_RAW_DATA_DIR=data/raw
IQ_REPORT_DIR=output
IQ_HOST=127.0.0.1
IQ_PORT=8000
IQ_ENABLE_SCHEDULER=false

# Capital IQ values may not leave this machine until your NTU/S&P agreement
# permits external model processing and this explicit gate is enabled.
CIQ_EXTERNAL_PROCESSING_CONFIRMED=false
CIQ_CLOUD_STORAGE_CONFIRMED=false

# DeepSeek official API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANALYST_MODEL=deepseek-v4-pro
DEEPSEEK_DECISION_MODEL=deepseek-v4-pro

# Alpaca paper trading only. Live endpoints are rejected by the application.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
